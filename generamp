                    // Add logic for auto-calculations if needed
                    console.log('Value updated:', this.value);
                });
            });
        }
        
        // Initialize calculations on page load
        calculateCompletion();
        
        // Add status color coding based on values
        function updateStatusColors() {
            const inputs = document.querySelectorAll('.input-field');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    const value = parseFloat(this.value);
                    const cell = this.parentElement;
                    
                    if (this.value.toLowerCase().includes('sí') || this.value.toLowerCase().includes('yes')) {
                        cell.classList.add('status-good');
                    } else if (value >= 90) {
                        cell.classList.add('status-good');
                    } else if (value >= 70) {
                        cell.classList.add('status-warning');
                    } else if (value < 70 && value > 0) {
                        cell.classList.add('status-critical');
                    }
                });
            });
        }
        
        updateStatusColors();
